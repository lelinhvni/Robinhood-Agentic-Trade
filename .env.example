# Claude API key (or use `ant auth login`)
ANTHROPIC_API_KEY=

# Robinhood Crypto Trading API credentials.
# Paper mode: optional, used only for live quotes (otherwise prices are simulated).
# Live mode (--live): required, and used to place real orders.
ROBINHOOD_API_KEY=
ROBINHOOD_PRIVATE_KEY_BASE64=

# Live mode: refuse to trade unless the API key belongs to this crypto account number.
ROBINHOOD_EXPECTED_ACCOUNT=

# Live mode: maximum USD per order (default 5).
AGENTIC_TRADE_LIVE_MAX_ORDER_USD=5
